#!/bin/bash
# LumaPOS administrative helper for the store Mac.
#
# Installed root-owned at /usr/local/libexec/lumapos-admin by
# install-admin-helper.sh, together with a sudoers rule that lets the store
# Mac's user run it without a password. It therefore accepts only a fixed set
# of commands and never executes files from user-writable locations:
#
#   lumapos-admin deploy
#       Put /Users/Shared/LumaPOS/app-next (built by build-release.sh) in place
#       of /Users/Shared/LumaPOS/app and restart web, sync and notifications.
#       Restores the previous release if /api/health/live does not answer.
#       Then restarts the backup worker onto the new release only while it
#       is idle (no backup stage directory and no pg_dump/rclone child), so a
#       running backup is never cut.
#   lumapos-admin service start|stop|restart <postgres|web|sync|notifications|backups|cloudflared>
#   lumapos-admin log <postgres|web|sync|notifications|backups|cloudflared> [lines]
#   lumapos-admin version | status
#
# Packaged layout (LumaPOS.app; see docs/mac-host-installer-plan.md):
#
#   lumapos-admin bootstrap <user>
#       Only from the macOS administrator prompt, never through sudoers:
#       installs this helper and its sudoers rule, creates the service
#       accounts and directories and writes the launchd definitions.
#   lumapos-admin create-accounts
#   lumapos-admin install-runtime <lumapos-runtime-*.tar.gz> [sha256]
#       Extracts into runtime/<version> after checking every file against
#       manifest.json; the tree becomes root-owned.
#   lumapos-admin activate-runtime <version>
#       Points current at it, runs migrations, restarts the app services and
#       returns to the previous runtime if /api/health/live does not answer.
#   lumapos-admin rollback-runtime
#   lumapos-admin init-database
#       initdb with the bundled PostgreSQL, owner and runtime roles with
#       random passwords written only to secrets/runtime.env.
#   lumapos-admin migrate
#   lumapos-admin write-secret <runtime.env|rclone.conf|cloudflared.yml|cloudflared-tunnel.json>  (stdin)
#   lumapos-admin init-runtime-env [public-url]
#       Default settings and generated keys; existing keys are kept.
#   lumapos-admin backup-key
#       Prints the backup encryption key so the owner can keep a copy.
#   lumapos-admin provision-store <slug> <owner-email>
#       stdin: store name, owner name, owner password (one per line).
#   lumapos-admin configure-tunnel <hostname> [more hostnames]
#       stdin: Cloudflare tunnel credentials JSON.
#   lumapos-admin start-services
#   lumapos-admin configure-drive <remote>
#       stdin: rclone.conf with the Google Drive remote; sets the backup folder
#       and creates it on Drive when it does not exist yet.
#   lumapos-admin set-backup-key
#       stdin: the old Mac's backup key; only while the database is empty.
#   lumapos-admin set-network <local|lan>
#       lan: the web server also listens on the store network (http, .local).
#   lumapos-admin restore-file <path.lumaenc>
#       Restores an archive file the owner picked (from export-for-move).
#   lumapos-admin export-for-move | cancel-move
#       Stops the store and writes an archive to exports/ for a new Mac.
#   lumapos-admin uninstall [keep-data | delete-data YYYYMMDD]
#   lumapos-admin list-backups
#       The archives in the Drive folder, newest first, as JSON.
#   lumapos-admin restore-backup <google-drive/YYYY/MM/DD/lumapos-<uuid>.lumaenc>
#       Restores database and media into an empty install, then migrates.
#
# Progress lines start with "STEP:" so the Mac host console can show them.
set -uo pipefail
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
umask 022

readonly HELPER_VERSION=10
readonly LUMAPOS_ROOT=/Users/Shared/LumaPOS
readonly LIVE_ROOT="$LUMAPOS_ROOT/app"
readonly STAGING_ROOT="$LUMAPOS_ROOT/app-next"
readonly SERVICE_USER=_lumapos_svc
readonly DEPLOY_SERVICES=(web sync notifications)
readonly KEEP_PREVIOUS=2

step() { printf 'STEP:%s\n' "$1"; }
fail() { printf '%s\n' "$1" >&2; exit "${2:-1}"; }

[[ "$(id -u)" == 0 ]] || fail "lumapos-admin must run as root (sudo)" 77

service_name() {
  case "${1:-}" in
    postgres|web|sync|notifications|backups|cloudflared) printf '%s' "$1" ;;
    *) fail "Unknown LumaPOS service: ${1:-}" 64 ;;
  esac
}

plist_of() { printf '/Library/LaunchDaemons/com.lumapos.%s.plist' "$1"; }
target_of() { printf 'system/com.lumapos.%s' "$1"; }
is_loaded() { launchctl print "$(target_of "$1")" >/dev/null 2>&1; }

load_service() {
  local name="$1"
  [[ -f "$(plist_of "$name")" ]] || { echo "Missing $(plist_of "$name")" >&2; return 1; }
  # A service turned off by export-for-move or uninstall stays disabled
  # across reboots until it is loaded again here.
  launchctl enable "$(target_of "$name")" 2>/dev/null || true
  # bootout is asynchronous: retry while launchd finishes unloading.
  for _ in $(seq 1 15); do
    if is_loaded "$name"; then
      launchctl kickstart "$(target_of "$name")" >/dev/null 2>&1 || true
      return 0
    fi
    launchctl bootstrap system "$(plist_of "$name")" 2>/dev/null && return 0
    sleep 2
  done
  echo "Could not load com.lumapos.$name" >&2
  return 1
}

unload_services() {
  local name
  for name in "$@"; do launchctl bootout "$(target_of "$name")" 2>/dev/null || true; done
  for _ in $(seq 1 30); do
    local loaded=0
    for name in "$@"; do is_loaded "$name" && loaded=1; done
    [[ $loaded == 0 ]] && return 0
    sleep 1
  done
}

load_services() {
  local name failed=0
  for name in "$@"; do load_service "$name" || failed=1; done
  return $failed
}

wait_live() {
  for _ in $(seq 1 45); do
    [[ "$(curl -s -m 5 -o /dev/null -w '%{http_code}' http://127.0.0.1:3000/api/health/live)" == 200 ]] && return 0
    sleep 2
  done
  return 1
}

# The staging tree is written by an unprivileged user. Root only renames it and
# fixes ownership of the cache directory, so refuse anything that could point
# those operations elsewhere.
check_staging() {
  [[ -d "$STAGING_ROOT" && ! -L "$STAGING_ROOT" ]] || fail "No release at $STAGING_ROOT"
  [[ ! -L "$STAGING_ROOT/.next" && -s "$STAGING_ROOT/.next/BUILD_ID" && ! -L "$STAGING_ROOT/.next/BUILD_ID" ]] \
    || fail "$STAGING_ROOT has no build (run build-release.sh first)"
  [[ ! -e "$STAGING_ROOT/.next/cache" || ( -d "$STAGING_ROOT/.next/cache" && ! -L "$STAGING_ROOT/.next/cache" ) ]] \
    || fail "$STAGING_ROOT/.next/cache must be a plain directory"
  local dotenv
  for dotenv in .env .env.local .env.production .env.production.local; do
    [[ -e "$STAGING_ROOT/$dotenv" || -L "$STAGING_ROOT/$dotenv" ]] && fail "Release contains $dotenv"
  done
  [[ -f "$STAGING_ROOT/ops/shared/run-service.sh" && ! -L "$STAGING_ROOT/ops/shared/run-service.sh" ]] \
    || fail "Release has no ops/shared/run-service.sh"
}

prune_previous() {
  ls -1d "$LUMAPOS_ROOT"/app-prev-* 2>/dev/null | sort -r | tail -n +$((KEEP_PREVIOUS + 1)) | while read -r old; do
    [[ -d "$old" && ! -L "$old" ]] && rm -rf -- "$old"
  done
}

# The backup worker runs from the live release but is not stopped for a
# deploy: a backup in progress (pg_dump, encryption, rclone upload) must not be
# killed. Restart it onto the new release only when it is idle;
# otherwise it keeps running the previous code until the next deploy.
descendants_of() {
  local child
  for child in $(pgrep -P "$1" 2>/dev/null); do
    printf '%s\n' "$child"
    descendants_of "$child"
  done
}

# Busy = any descendant that is not Bun itself (the classic layout runs the
# worker under `bun run`, which always has a Bun child).
backup_tools_running() {
  local process command
  for process in $(descendants_of "$1"); do
    command="$(ps -o comm= -p "$process" 2>/dev/null)" || continue
    [[ -n "$command" && "$(basename "$command")" != bun ]] && return 0
  done
  return 1
}

# A backup also has in-process phases (checksums, encryption) with no child.
# Its private stage directory (.lumapos-backup-*) exists from the first step
# to the last, and the worker removes leftovers when it starts.
backup_stage_present() {
  local env_file stage_root
  env_file="$(/usr/libexec/PlistBuddy -c 'Print :EnvironmentVariables:LUMAPOS_ENV_FILE' \
    /Library/LaunchDaemons/com.lumapos.backups.plist 2>/dev/null)"
  [[ -n "$env_file" && -f "$env_file" ]] \
    && stage_root="$(sed -n 's/^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}LUMAPOS_BACKUP_STAGING_ROOT=//p' "$env_file" \
      | tail -n 1 | tr -d "\"'")"
  [[ -n "${stage_root:-}" && "$stage_root" == /* ]] || return 1
  compgen -G "$stage_root/.lumapos-backup-*" >/dev/null
}

refresh_backups() {
  is_loaded backups || return 0
  local pid
  pid="$(launchctl print "$(target_of backups)" 2>/dev/null | awk '/^\tpid = /{print $3; exit}')"
  if backup_stage_present || { [[ "$pid" =~ ^[0-9]+$ ]] && backup_tools_running "$pid"; }; then
    step "backups busy"
    return 0
  fi
  launchctl kickstart -k "$(target_of backups)" >/dev/null 2>&1 && step "backups restarted"
  return 0
}

cmd_deploy() {
  # A packaged install updates through install-runtime + activate-runtime.
  [[ -L "$LUMAPOS_ROOT/current" ]] && fail "This Mac runs the packaged install; deploy a runtime with install-runtime and activate-runtime" 65
  check_staging
  [[ -d "$LIVE_ROOT" && ! -L "$LIVE_ROOT" ]] || fail "No live release at $LIVE_ROOT"
  local stamp previous
  stamp="$(date +%Y%m%d_%H%M%S)"
  previous="$LUMAPOS_ROOT/app-prev-$stamp"

  step "stop"
  unload_services "${DEPLOY_SERVICES[@]}"

  step "swap"
  if ! mv -- "$LIVE_ROOT" "$previous"; then
    load_services "${DEPLOY_SERVICES[@]}"
    fail "Could not move the live release aside"
  fi
  if ! mv -- "$STAGING_ROOT" "$LIVE_ROOT"; then
    mv -- "$previous" "$LIVE_ROOT"
    load_services "${DEPLOY_SERVICES[@]}"
    fail "Could not move the new release in"
  fi
  mkdir -p -- "$LIVE_ROOT/.next/cache"
  chown -R -P "$SERVICE_USER:staff" -- "$LIVE_ROOT/.next/cache"

  step "start"
  if load_services "${DEPLOY_SERVICES[@]}" && wait_live; then
    step "live"
    refresh_backups
    prune_previous
    return 0
  fi

  step "rollback"
  unload_services "${DEPLOY_SERVICES[@]}"
  local failed_release="$LUMAPOS_ROOT/app-failed-$stamp"
  mv -- "$LIVE_ROOT" "$failed_release"
  mv -- "$previous" "$LIVE_ROOT"
  load_services "${DEPLOY_SERVICES[@]}"
  wait_live
  fail "The new release did not come up; the previous release is running again (failed release kept at $failed_release)"
}

# ---- packaged layout (LumaPOS.app) -----------------------------------------
#
# /Users/Shared/LumaPOS/runtime/<version>/{app,postgresql-17,tools/bin}  root-owned
# /Users/Shared/LumaPOS/current -> runtime/<version>
# /Users/Shared/LumaPOS/postgres/{data,run}                              _lumapos_db, 0700
# /Users/Shared/LumaPOS/secrets/runtime.env                              _lumapos_svc, 0600
#
# Root never executes files from a runtime: PostgreSQL tools run as
# _lumapos_db and the web release as _lumapos_svc.

readonly RUNTIME_DIR="$LUMAPOS_ROOT/runtime"
readonly CURRENT_LINK="$LUMAPOS_ROOT/current"
readonly PG_DIR="$LUMAPOS_ROOT/postgres"
readonly PGDATA="$PG_DIR/data"
readonly PG_SOCKET_DIR="$PG_DIR/run"
readonly PG_PORT=5432
readonly SECRETS_DIR="$LUMAPOS_ROOT/secrets"
readonly RUNTIME_ENV="$SECRETS_DIR/runtime.env"
readonly LOG_DIR="$LUMAPOS_ROOT/logs"
readonly DB_USER=_lumapos_db
readonly DATABASE_NAME=lumapos_prod
readonly OWNER_ROLE=lumapos_owner
readonly RUNTIME_ROLE=lumapos_runtime
readonly PACKAGED_SERVICES=(postgres web sync notifications backups cloudflared)
readonly APP_SERVICES=(web sync notifications)
readonly KEEP_RUNTIMES=3
readonly MAX_RUNTIME_ARCHIVE_BYTES=$((2 * 1024 * 1024 * 1024))
readonly VERSION_PATTERN='^[0-9]{8}\.[0-9]{6}-[0-9a-f]{8}$'

runtime_path() { printf '%s/%s' "$RUNTIME_DIR" "$1"; }
current_version() {
  local target
  target="$(readlink "$CURRENT_LINK" 2>/dev/null)" || return 1
  target="${target##*/}"
  [[ "$target" =~ $VERSION_PATTERN && -d "$(runtime_path "$target")" ]] || return 1
  printf '%s' "$target"
}
# JSON values come from root-owned manifests; JavaScriptCore (osascript) is on
# every Mac, unlike python3.
manifest_value() {
  /usr/bin/osascript -l JavaScript -e '
    function run(argv) {
      const text = $.NSString.stringWithContentsOfFileEncodingError(argv[0], $.NSUTF8StringEncoding, null);
      let value = JSON.parse(ObjC.unwrap(text));
      for (const key of argv[1].split(".")) value = value == null ? undefined : value[key];
      return value === undefined || value === null ? "" : String(value);
    }' "$1" "$2" 2>/dev/null
}
manifest_files() {
  /usr/bin/osascript -l JavaScript -e '
    function run(argv) {
      const text = $.NSString.stringWithContentsOfFileEncodingError(argv[0], $.NSUTF8StringEncoding, null);
      const files = JSON.parse(ObjC.unwrap(text)).files || {};
      return Object.keys(files).sort().map((name) => files[name] + "  ./" + name).join("\n");
    }' "$1" 2>/dev/null
}
postgres_bin() { printf '%s/postgresql-%s/bin' "$CURRENT_LINK" "$(manifest_value "$CURRENT_LINK/manifest.json" postgres.major)"; }

as_db_user() { sudo -u "$DB_USER" -H -- "$@"; }
db_psql() {
  # psql as the cluster superuser over the private socket (peer auth).
  as_db_user "$(postgres_bin)/psql" -X -q -v ON_ERROR_STOP=1 -h "$PG_SOCKET_DIR" -p "$PG_PORT" "$@"
}
wait_postgres() {
  for _ in $(seq 1 60); do
    as_db_user "$(postgres_bin)/pg_isready" -q -h "$PG_SOCKET_DIR" -p "$PG_PORT" && return 0
    sleep 1
  done
  return 1
}

# ---- accounts and directories ----

free_id() {
  local id
  for id in $(seq 401 499); do
    dscl . -search /Users UniqueID "$id" 2>/dev/null | grep -q . && continue
    dscl . -search /Groups PrimaryGroupID "$id" 2>/dev/null | grep -q . && continue
    printf '%s' "$id"; return 0
  done
  return 1
}

ensure_account() {
  local name="$1" real_name="$2" own_group="$3" id gid
  if dscl . -read "/Users/$name" UniqueID >/dev/null 2>&1; then return 0; fi
  id="$(free_id)" || fail "No free system user id for $name"
  gid=20
  if [[ "$own_group" == yes ]]; then
    gid="$id"
    dscl . -create "/Groups/$name" || fail "Could not create group $name"
    dscl . -create "/Groups/$name" PrimaryGroupID "$gid"
    dscl . -create "/Groups/$name" Password '*'
  fi
  dscl . -create "/Users/$name" || fail "Could not create user $name"
  dscl . -create "/Users/$name" UniqueID "$id"
  dscl . -create "/Users/$name" PrimaryGroupID "$gid"
  dscl . -create "/Users/$name" UserShell /usr/bin/false
  dscl . -create "/Users/$name" NFSHomeDirectory /var/empty
  dscl . -create "/Users/$name" RealName "$real_name"
  dscl . -create "/Users/$name" Password '*'
  dscl . -create "/Users/$name" IsHidden 1
  step "account $name ($id)"
}

ensure_dir() {
  local path="$1" owner="$2" mode="$3"
  [[ -L "$path" ]] && fail "$path must not be a symlink"
  mkdir -p -- "$path" || fail "Could not create $path"
  # BSD chown/chmod take no "--" after the owner or mode operand.
  chown "$owner" "$path" && chmod "$mode" "$path" || fail "Could not set permissions on $path"
}

cmd_create_accounts() {
  ensure_account "$SERVICE_USER" "LumaPOS services" no
  ensure_account "$DB_USER" "LumaPOS PostgreSQL" yes
  ensure_dir "$LUMAPOS_ROOT" root:wheel 0755
  ensure_dir "$RUNTIME_DIR" root:wheel 0755
  ensure_dir "$PG_DIR" "$DB_USER:$DB_USER" 0700
  ensure_dir "$PG_SOCKET_DIR" "$DB_USER:$DB_USER" 0700
  ensure_dir "$SECRETS_DIR" "$SERVICE_USER:staff" 0700
  ensure_dir "$LOG_DIR" "$SERVICE_USER:staff" 0755
  ensure_dir "$LUMAPOS_ROOT/media" "$SERVICE_USER:staff" 0700
  ensure_dir "$LUMAPOS_ROOT/backup-staging" "$SERVICE_USER:staff" 0700
  # launchd opens each log file as the job's user.
  local log
  [[ -e "$LOG_DIR/postgres.log" ]] || install -o "$DB_USER" -g "$DB_USER" -m 0640 /dev/null "$LOG_DIR/postgres.log"
  for log in web sync notifications backups cloudflared; do
    [[ -e "$LOG_DIR/$log.log" ]] || install -o "$SERVICE_USER" -g staff -m 0640 /dev/null "$LOG_DIR/$log.log"
  done
  step "accounts ready"
}

# ---- launchd definitions (generated here; no caller-supplied content) ----

write_packaged_plist() {
  local name="$1" plist tmp_dir tmp pg_major
  plist="$(plist_of "$name")"
  # PlistBuddy creates the file; it cannot start from an empty one.
  tmp_dir="$(mktemp -d)" || fail "Could not create a temporary directory"
  tmp="$tmp_dir/com.lumapos.$name.plist"
  local pb=/usr/libexec/PlistBuddy
  pg_major="${2:-17}"
  $pb -c "Add :Label string com.lumapos.$name" "$tmp" >/dev/null
  $pb -c "Add :RunAtLoad bool true" "$tmp"
  $pb -c "Add :KeepAlive bool true" "$tmp"
  $pb -c "Add :ThrottleInterval integer 30" "$tmp"
  $pb -c "Add :ProgramArguments array" "$tmp"
  $pb -c "Add :StandardOutPath string $LOG_DIR/$name.log" "$tmp"
  $pb -c "Add :StandardErrorPath string $LOG_DIR/$name.log" "$tmp"
  case "$name" in
    postgres)
      $pb -c "Add :UserName string $DB_USER" "$tmp"
      $pb -c "Add :ProgramArguments:0 string $CURRENT_LINK/postgresql-$pg_major/bin/postgres" "$tmp"
      $pb -c "Add :ProgramArguments:1 string -D" "$tmp"
      $pb -c "Add :ProgramArguments:2 string $PGDATA" "$tmp"
      # SIGTERM is a smart shutdown; clients are stopped before it.
      $pb -c "Add :ExitTimeOut integer 120" "$tmp"
      ;;
    cloudflared)
      $pb -c "Add :UserName string $SERVICE_USER" "$tmp"
      $pb -c "Add :ProgramArguments:0 string $CURRENT_LINK/tools/bin/cloudflared" "$tmp"
      $pb -c "Add :ProgramArguments:1 string tunnel" "$tmp"
      $pb -c "Add :ProgramArguments:2 string --no-autoupdate" "$tmp"
      $pb -c "Add :ProgramArguments:3 string --config" "$tmp"
      $pb -c "Add :ProgramArguments:4 string $SECRETS_DIR/cloudflared.yml" "$tmp"
      $pb -c "Add :ProgramArguments:5 string run" "$tmp"
      ;;
    web|sync|notifications|backups)
      $pb -c "Add :UserName string $SERVICE_USER" "$tmp"
      $pb -c "Add :WorkingDirectory string $CURRENT_LINK/app" "$tmp"
      $pb -c "Add :ProgramArguments:0 string /bin/bash" "$tmp"
      $pb -c "Add :ProgramArguments:1 string $CURRENT_LINK/app/ops/shared/run-service.sh" "$tmp"
      $pb -c "Add :ProgramArguments:2 string $name" "$tmp"
      $pb -c "Add :EnvironmentVariables dict" "$tmp"
      $pb -c "Add :EnvironmentVariables:LUMAPOS_APP_ROOT string $CURRENT_LINK/app" "$tmp"
      $pb -c "Add :EnvironmentVariables:LUMAPOS_BUN_BIN string $CURRENT_LINK/tools/bin/bun" "$tmp"
      $pb -c "Add :EnvironmentVariables:LUMAPOS_ENV_FILE string $RUNTIME_ENV" "$tmp"
      $pb -c "Add :EnvironmentVariables:LUMAPOS_POSTGRES_BIN_DIR string $CURRENT_LINK/postgresql-$pg_major/bin" "$tmp"
      $pb -c "Add :EnvironmentVariables:LUMAPOS_RCLONE_BIN string $CURRENT_LINK/tools/bin/rclone" "$tmp"
      $pb -c "Add :EnvironmentVariables:PATH string $CURRENT_LINK/tools/bin:$CURRENT_LINK/postgresql-$pg_major/bin:/usr/bin:/bin:/usr/sbin:/sbin" "$tmp"
      # Backups get time to finish an upload when stopped.
      [[ "$name" == backups ]] && $pb -c "Add :ExitTimeOut integer 900" "$tmp"
      ;;
  esac
  local installed=0
  plutil -lint -s "$tmp" >/dev/null && install -o root -g wheel -m 0644 "$tmp" "$plist" && installed=1
  rm -f "$tmp"
  rmdir "$tmp_dir"
  [[ "$installed" == 1 ]] || fail "Could not install a valid $plist"
}

# A plist that does not run from $CURRENT_LINK belongs to the classic store
# setup; bootstrap leaves it alone (moving that Mac is a separate step).
is_packaged_plist() {
  /usr/libexec/PlistBuddy -c 'Print :ProgramArguments' "$(plist_of "$1")" 2>/dev/null | grep -q "$CURRENT_LINK/"
}

install_plists() {
  local name skipped=0
  for name in "${PACKAGED_SERVICES[@]}"; do
    if [[ -f "$(plist_of "$name")" ]] && ! is_packaged_plist "$name"; then
      step "kept existing com.lumapos.$name"
      skipped=1
      continue
    fi
    write_packaged_plist "$name"
  done
  return 0
}

# ---- bootstrap ----

# Run once from LumaPOS.app through the macOS administrator prompt:
#   osascript … do shell script "/bin/bash <app>/Contents/Resources/admin/lumapos-admin bootstrap <user>" with administrator privileges
# Never through the sudoers rule, which would let that user grant itself
# rights for another account.
cmd_bootstrap() {
  local user="${1:-}" source dir perms rule_file
  [[ -z "${SUDO_USER:-}" ]] || fail "bootstrap runs only from the administrator prompt" 77
  [[ "$user" =~ ^[A-Za-z0-9._-]+$ && "$user" != root ]] && id "$user" >/dev/null 2>&1 || fail "Unknown user: $user" 67
  source="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")"
  bash -n "$source" || fail "Helper source does not parse"
  for dir in /usr /usr/local; do
    [[ "$(stat -f '%Su' "$dir")" == root && ! -L "$dir" ]] || fail "$dir must be owned by root"
    perms="$(stat -f '%Lp' "$dir")"
    (( (8#$perms & 8#022) == 0 )) || fail "$dir must not be group/world writable"
  done

  step "helper"
  install -d -o root -g wheel -m 0755 /usr/local/libexec
  if [[ "$source" != /usr/local/libexec/lumapos-admin ]]; then
    install -o root -g wheel -m 0755 "$source" /usr/local/libexec/lumapos-admin || fail "Could not install helper"
  fi
  rule_file="$(mktemp)"
  printf '%s\n' "# Managed by lumapos-admin bootstrap" \
    "$user ALL=(root) NOPASSWD: /usr/local/libexec/lumapos-admin" > "$rule_file"
  visudo -cf "$rule_file" >/dev/null || { rm -f "$rule_file"; fail "sudoers rule is invalid"; }
  install -o root -g wheel -m 0440 "$rule_file" /etc/sudoers.d/lumapos
  rm -f "$rule_file"
  visudo -c >/dev/null || fail "sudoers configuration is invalid"

  step "accounts"
  cmd_create_accounts
  step "launchd"
  install_plists
  step "bootstrapped helper $HELPER_VERSION for $user"
}

# ---- runtime install / activate / rollback ----

# Every file in the tree must be listed in manifest.json with its SHA-256, and
# nothing else may exist (no devices, fifos or symlinks leaving the tree).
verify_runtime_tree() {
  local root="$1" expected actual link target
  [[ -f "$root/manifest.json" && ! -L "$root/manifest.json" ]] || return 1
  [[ "$(manifest_value "$root/manifest.json" kind)" == lumapos-runtime ]] || return 1
  [[ "$(manifest_value "$root/manifest.json" platform)" == darwin-arm64 ]] || return 1
  if find "$root" ! -type f ! -type d ! -type l | grep -q .; then return 1; fi
  while IFS= read -r -d '' link; do
    target="$(readlink "$link")"
    [[ "$target" != /* ]] || return 1
    # Resolve the link's directory physically and require it to stay inside.
    target="$(cd "$(dirname "$link")" 2>/dev/null && cd "$(dirname "$target")" 2>/dev/null && pwd -P)" || return 1
    [[ "$target" == "$root" || "$target" == "$root"/* ]] || return 1
  done < <(find "$root" -type l -print0)
  expected="$(manifest_files "$root/manifest.json")"
  actual="$(cd "$root" && find . -type f ! -path ./manifest.json -print0 | LC_ALL=C sort -z | xargs -0 shasum -a 256)"
  [[ -n "$expected" && "$(printf '%s\n' "$expected" | LC_ALL=C sort)" == "$(printf '%s\n' "$actual" | LC_ALL=C sort)" ]]
}

cmd_install_runtime() {
  local archive="${1:-}" expected_sha="${2:-}" size incoming top version target
  [[ "$archive" == /* && -f "$archive" && ! -L "$archive" ]] || fail "Runtime archive must be an absolute path to a file" 64
  [[ "$(basename "$archive")" =~ ^lumapos-runtime-[0-9]{8}\.[0-9]{6}-[0-9a-f]{8}\.tar\.gz$ ]] || fail "Unexpected runtime archive name" 64
  size="$(stat -f '%z' "$archive")"
  (( size > 0 && size < MAX_RUNTIME_ARCHIVE_BYTES )) || fail "Runtime archive size is out of range" 64
  if [[ -n "$expected_sha" ]]; then
    [[ "$expected_sha" =~ ^[0-9a-f]{64}$ ]] || fail "SHA-256 must be 64 hex characters" 64
    [[ "$(shasum -a 256 "$archive" | awk '{print $1}')" == "$expected_sha" ]] || fail "Runtime archive checksum mismatch"
  fi
  [[ -d "$RUNTIME_DIR" && ! -L "$RUNTIME_DIR" ]] || fail "Run bootstrap first"

  incoming="$(mktemp -d "$RUNTIME_DIR/.incoming.XXXXXX")" || fail "Could not create a staging directory"
  chmod 0700 "$incoming"
  # shellcheck disable=SC2064 # bake the path in: the trap runs after return
  trap "rm -rf -- '$incoming'" EXIT
  step "extract"
  # bsdtar refuses "..", absolute paths and writing through symlinks by
  # default; -o drops archive ownership.
  tar -xzof "$archive" -C "$incoming" || fail "Could not extract the runtime archive"
  top="$(ls -1A "$incoming")"
  [[ "$(printf '%s\n' "$top" | wc -l | tr -d ' ')" == 1 && "$top" =~ ^lumapos-runtime-(.+)$ ]] || fail "Runtime archive must contain one lumapos-runtime-<version> directory"
  version="${BASH_REMATCH[1]}"
  [[ "$version" =~ $VERSION_PATTERN ]] || fail "Unexpected runtime version"
  [[ -d "$incoming/$top" && ! -L "$incoming/$top" ]] || fail "Runtime archive layout is invalid"

  step "verify"
  verify_runtime_tree "$incoming/$top" || fail "Runtime files do not match manifest.json"
  [[ "$(manifest_value "$incoming/$top/manifest.json" version)" == "$version" ]] || fail "Manifest version does not match the archive"
  target="$(runtime_path "$version")"
  [[ ! -e "$target" ]] || { step "already installed $version"; return 0; }

  chown -R -h root:wheel "$incoming/$top"
  chmod -R go-w "$incoming/$top"
  chmod 0755 "$incoming/$top"
  # Next.js writes its cache next to the server; it is the only writable path.
  mkdir -p "$incoming/$top/app/.next/cache"
  chown "$SERVICE_USER:staff" "$incoming/$top/app/.next/cache"
  chmod 0700 "$incoming/$top/app/.next/cache"
  mv -- "$incoming/$top" "$target" || fail "Could not move the runtime into place"
  rm -rf -- "$incoming"
  trap - EXIT
  step "installed $version"
}

point_current_at() {
  # ln -sfh replaces the link itself, never a directory it points to.
  ln -sfh "runtime/$1" "$CURRENT_LINK" || return 1
  printf '%s\n' "$1" > "$RUNTIME_DIR/.current"
}

# The PostgreSQL server keeps running across runtime switches unless the
# PostgreSQL build changes.
postgres_version_of() { manifest_value "$(runtime_path "$1")/manifest.json" postgres.version; }

# Runtimes in use (current, previous, the one PostgreSQL runs from) are kept.
prune_runtimes() {
  local current previous running keep=0 version
  current="$(current_version 2>/dev/null || true)"
  previous="$(cat "$RUNTIME_DIR/.previous" 2>/dev/null || true)"
  # Processes start through the current symlink, so their command lines do not
  # name a runtime; lsof reports the resolved paths of the executables and
  # libraries they have mapped. PostgreSQL loads extensions such as plpgsql
  # from its own runtime for every new connection, so that runtime must stay.
  running="$(lsof -nP -d txt -Fn 2>/dev/null | sed -n "s|^n$RUNTIME_DIR/\([^/]*\)/.*|\1|p" | sort -u)"
  for version in $(ls -1 "$RUNTIME_DIR" 2>/dev/null | grep -E "$VERSION_PATTERN" | sort -r); do
    keep=$((keep + 1))
    [[ "$version" == "$current" || "$version" == "$previous" ]] && continue
    printf '%s\n' "$running" | grep -qx "$version" && continue
    (( keep > KEEP_RUNTIMES )) && rm -rf -- "$(runtime_path "$version")"
  done
}

restart_app_services() {
  unload_services "${APP_SERVICES[@]}"
  load_services "${APP_SERVICES[@]}" && wait_live
}

cmd_activate_runtime() {
  local version="${1:-}" mode="${2:-}" previous
  [[ "$version" =~ $VERSION_PATTERN ]] || fail "Unexpected runtime version" 64
  [[ -d "$(runtime_path "$version")" && ! -L "$(runtime_path "$version")" ]] || fail "Runtime $version is not installed" 66
  previous="$(current_version 2>/dev/null || true)"
  [[ "$previous" != "$version" ]] || { step "already active $version"; return 0; }

  step "switch $version"
  point_current_at "$version" || fail "Could not switch the current runtime"
  [[ -n "$previous" ]] && printf '%s\n' "$previous" > "$RUNTIME_DIR/.previous"

  if [[ -n "$previous" && "$(postgres_version_of "$previous")" != "$(postgres_version_of "$version")" ]] \
    && is_loaded postgres; then
    step "restart postgres"
    unload_services "${APP_SERVICES[@]}" backups
    unload_services postgres
    load_service postgres
  elif [[ -f "$PGDATA/PG_VERSION" ]] && is_loaded postgres; then
    # Same PostgreSQL version: a fast restart moves the server onto the new
    # runtime (launchd starts it again through current), so the old runtime
    # can be removed later without taking plpgsql and the other modules away.
    step "restart postgres"
    as_db_user "$(postgres_bin)/pg_ctl" -D "$PGDATA" -m fast -w -t 60 stop >/dev/null 2>&1
    load_service postgres
  fi
  if [[ ! -f "$PGDATA/PG_VERSION" ]]; then
    # First install: services start after init-database (start-services).
    step "active $version (no database yet)"
    return 0
  fi
  if [[ -f "$PGDATA/PG_VERSION" ]]; then
    wait_postgres || { [[ -n "$previous" ]] && point_current_at "$previous"; fail "PostgreSQL did not start"; }
    if [[ "$mode" != --no-migrate ]]; then
      step "migrate"
      if ! run_migrations; then
        [[ -n "$previous" ]] && point_current_at "$previous"
        fail "Migrations failed; the previous runtime stays active"
      fi
    fi
  fi

  step "start"
  if restart_app_services; then
    step "live"
    is_loaded cloudflared && launchctl kickstart -k "$(target_of cloudflared)" >/dev/null 2>&1
    if is_loaded backups; then refresh_backups; else load_service backups; fi
    prune_runtimes
    step "active $version"
    return 0
  fi

  if [[ -n "$previous" ]]; then
    step "rollback"
    point_current_at "$previous"
    printf '%s\n' "$version" > "$RUNTIME_DIR/.failed"
    restart_app_services
    fail "Runtime $version did not come up; $previous is running again"
  fi
  fail "Runtime $version did not come up"
}

cmd_rollback_runtime() {
  local previous
  previous="$(cat "$RUNTIME_DIR/.previous" 2>/dev/null || true)"
  [[ "$previous" =~ $VERSION_PATTERN && -d "$(runtime_path "$previous")" ]] || fail "No previous runtime to roll back to" 66
  # The schema only moves forward; the previous runtime runs against it.
  cmd_activate_runtime "$previous" --no-migrate
}

# ---- database ----

port_in_use() { lsof -nP -iTCP:"$PG_PORT" -sTCP:LISTEN >/dev/null 2>&1; }

set_env_value() {
  # Replaces or appends KEY=value in runtime.env, keeping owner and mode.
  local key="$1" value="$2" tmp
  tmp="$(mktemp "$SECRETS_DIR/.runtime.env.XXXXXX")" || return 1
  if [[ -f "$RUNTIME_ENV" ]]; then
    grep -v -E "^[[:space:]]*(export[[:space:]]+)?$key=" "$RUNTIME_ENV" > "$tmp" || true
  fi
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  chown "$SERVICE_USER:staff" "$tmp" && chmod 0600 "$tmp" && mv -f -- "$tmp" "$RUNTIME_ENV"
}

cmd_init_database() {
  local pgbin owner_password runtime_password
  current_version >/dev/null || fail "Activate a runtime first"
  dscl . -read "/Users/$DB_USER" UniqueID >/dev/null 2>&1 || fail "Run bootstrap first"
  [[ ! -e "$PGDATA/PG_VERSION" ]] || fail "A database cluster already exists at $PGDATA"
  port_in_use && fail "Port $PG_PORT is already in use (stop the other PostgreSQL first)"
  pgbin="$(postgres_bin)"

  step "initdb"
  ensure_dir "$PG_DIR" "$DB_USER:$DB_USER" 0700
  ensure_dir "$PG_SOCKET_DIR" "$DB_USER:$DB_USER" 0700
  [[ -d "$PGDATA" ]] && rmdir -- "$PGDATA" 2>/dev/null
  as_db_user "$pgbin/initdb" -D "$PGDATA" --encoding=UTF8 --locale-provider=libc \
    --locale=en_US.UTF-8 --auth-local=peer --auth-host=scram-sha-256 >/dev/null \
    || fail "initdb failed"
  as_db_user /bin/sh -c "cat >> '$PGDATA/postgresql.conf'" <<EOF

# LumaPOS (lumapos-admin init-database)
listen_addresses = '127.0.0.1'
port = $PG_PORT
unix_socket_directories = '$PG_SOCKET_DIR'
unix_socket_permissions = 0700
password_encryption = scram-sha-256
EOF

  step "start postgres"
  [[ -f "$(plist_of postgres)" ]] || write_packaged_plist postgres "$(manifest_value "$CURRENT_LINK/manifest.json" postgres.major)"
  load_service postgres || fail "Could not start PostgreSQL"
  wait_postgres || fail "PostgreSQL did not start"

  step "roles"
  owner_password="$(openssl rand -hex 24)"
  runtime_password="$(openssl rand -hex 24)"
  # Passwords go through stdin, never the command line.
  db_psql -d postgres <<EOF || fail "Could not create database roles"
\\set owner_password '$owner_password'
\\set runtime_password '$runtime_password'
CREATE ROLE $OWNER_ROLE LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION PASSWORD :'owner_password';
CREATE ROLE $RUNTIME_ROLE LOGIN BYPASSRLS NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION PASSWORD :'runtime_password';
CREATE ROLE authenticated NOLOGIN;
CREATE ROLE service_role NOLOGIN BYPASSRLS;
CREATE DATABASE $DATABASE_NAME OWNER $OWNER_ROLE ENCODING 'UTF8' TEMPLATE template0;
EOF
  db_psql -d "$DATABASE_NAME" -c "ALTER SCHEMA public OWNER TO $OWNER_ROLE" || fail "Could not hand the public schema to $OWNER_ROLE"

  step "runtime.env"
  set_env_value DATABASE_URL "postgresql://$RUNTIME_ROLE:$runtime_password@127.0.0.1:$PG_PORT/$DATABASE_NAME?sslmode=disable" \
    && set_env_value MIGRATION_DATABASE_URL "postgresql://$OWNER_ROLE:$owner_password@127.0.0.1:$PG_PORT/$DATABASE_NAME?sslmode=disable" \
    || fail "Could not write $RUNTIME_ENV"
  step "database ready"
}

# Compatibility objects and grants run as the owner role (so the owner owns
# them) inside a superuser session; the schema migrations run as the service
# user with MIGRATION_DATABASE_URL from runtime.env.
run_migrations() {
  local app="$CURRENT_LINK/app"
  [[ -f "$app/sql/bootstrap-local-postgres-compat.sql" && -f "$app/sql/grant-self-hosted-runtime-role.sql" ]] || {
    echo "Runtime has no sql/ scripts" >&2; return 1; }
  { printf 'SET ROLE %s;\n' "$OWNER_ROLE"; cat "$app/sql/bootstrap-local-postgres-compat.sql"; } \
    | db_psql -d "$DATABASE_NAME" || return 1
  sudo -u "$SERVICE_USER" -- /usr/bin/env -i \
    PATH="$CURRENT_LINK/tools/bin:/usr/bin:/bin" \
    LUMAPOS_APP_ROOT="$app" LUMAPOS_ENV_FILE="$RUNTIME_ENV" \
    LUMAPOS_BUN_BIN="$CURRENT_LINK/tools/bin/bun" \
    /bin/bash "$app/ops/shared/run-service.sh" migrate || return 1
  { printf 'SET ROLE %s;\n' "$OWNER_ROLE"; cat "$app/sql/grant-self-hosted-runtime-role.sql"; } \
    | db_psql -d "$DATABASE_NAME" || return 1
}

cmd_migrate() {
  current_version >/dev/null || fail "No active runtime"
  wait_postgres || fail "PostgreSQL is not running"
  run_migrations || fail "Migrations failed"
  step "migrated"
}

# ---- setup (first install) ----

env_has() { [[ -f "$RUNTIME_ENV" ]] && grep -q -E "^[[:space:]]*(export[[:space:]]+)?$1=" "$RUNTIME_ENV"; }
env_value() {
  [[ -f "$RUNTIME_ENV" ]] || return 1
  sed -n "s/^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}$1=//p" "$RUNTIME_ENV" | tail -n 1 | tr -d "\"'"
}
set_env_default() { env_has "$1" || set_env_value "$1" "$2"; }
random_hex() { openssl rand -hex "$1"; }

# Writes the settings a new store Mac needs and generates its own keys. Keys
# that already exist are never changed (a new backup key would make earlier
# archives unreadable).
cmd_init_runtime_env() {
  local public_url="${1:-}"
  [[ -d "$SECRETS_DIR" && ! -L "$SECRETS_DIR" ]] || fail "Run bootstrap first"
  if [[ -n "$public_url" ]]; then
    [[ "$public_url" =~ ^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?$ ]] || fail "Public URL must look like https://pos.example.com" 64
  fi
  set_env_default LUMAPOS_AUTH_PROVIDER lumapos
  set_env_default LUMAPOS_PRIMARY_DATABASE_CONFIRMED true
  set_env_default LUMAPOS_BACKUP_SOURCE_CONFIRMED true
  set_env_default LUMAPOS_SYNC_INBOX_ENABLED true
  set_env_default NOTIFICATION_QUEUE_PROVIDER database
  set_env_default MEDIA_WRITE_PROVIDER local
  set_env_default MEDIA_LOCAL_ROOT "$LUMAPOS_ROOT/media"
  set_env_default LUMAPOS_INTERNAL_URL "http://127.0.0.1:3000"
  set_env_default LUMAPOS_BACKUP_PROVIDER google-drive
  set_env_default LUMAPOS_BACKUP_STAGING_ROOT "$LUMAPOS_ROOT/backup-staging"
  set_env_default LUMAPOS_RCLONE_CONFIG "$SECRETS_DIR/rclone.conf"
  set_env_default LUMAPOS_BACKUP_REMOTE "lumapos:Backups/LumaPOS"
  set_env_default LUMAPOS_BACKUP_ENCRYPTION_KEY "$(random_hex 32)"
  set_env_default SERVICE_VAULT_ENCRYPTION_KEY "$(random_hex 32)"
  set_env_default MOBILE_CASHIER_CONTEXT_SECRET "$(random_hex 32)"
  set_env_default CRON_SECRET "$(random_hex 32)"
  if [[ -n "$public_url" ]]; then
    set_env_value LUMAPOS_PUBLIC_URL "$public_url"
  else
    set_env_default LUMAPOS_PUBLIC_URL "http://127.0.0.1:3000"
  fi
  step "runtime.env ready"
}

# The backup key is needed to restore an archive on another Mac, so the owner
# must keep a copy away from this Mac. Only the sudoers user can read it.
cmd_backup_key() {
  local key
  key="$(env_value LUMAPOS_BACKUP_ENCRYPTION_KEY)" || fail "No runtime.env"
  [[ "$key" =~ ^[0-9a-fA-F]{64}$ ]] || fail "No backup key yet (run init-runtime-env)" 66
  printf '%s\n' "$key"
}

# provision-store <slug> <owner-email>; stdin: store name, owner name and
# password on three lines.
cmd_provision_store() {
  local slug="${1:-}" email="${2:-}" store_name owner_name password app="$CURRENT_LINK/app"
  [[ "$slug" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ && ${#slug} -le 48 ]] || fail "Store code must be lowercase letters, digits and dashes" 64
  [[ "$email" =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ && ${#email} -le 254 ]] || fail "Owner email is invalid" 64
  IFS= read -r store_name || true
  IFS= read -r owner_name || true
  IFS= read -r password || true
  [[ -n "$store_name" && ${#store_name} -le 120 ]] || fail "Store name is required" 64
  [[ ${#owner_name} -le 120 ]] || fail "Owner name is too long" 64
  [[ -n "$password" ]] || fail "Owner password is required" 64
  current_version >/dev/null || fail "No active runtime"
  wait_postgres || fail "PostgreSQL is not running"
  [[ -f "$app/workers/provision-store.js" ]] || fail "This runtime cannot provision a store"
  local args=(--slug "$slug" --name "$store_name" --owner-email "$email")
  [[ -n "$owner_name" ]] && args+=(--owner-name "$owner_name")
  sudo -u "$SERVICE_USER" -- /usr/bin/env -i \
    PATH="$CURRENT_LINK/tools/bin:/usr/bin:/bin" \
    LUMAPOS_APP_ROOT="$app" LUMAPOS_ENV_FILE="$RUNTIME_ENV" \
    LUMAPOS_BUN_BIN="$CURRENT_LINK/tools/bin/bun" \
    LUMA_OWNER_PASSWORD="$password" \
    /bin/bash "$app/ops/shared/run-service.sh" provision-store "${args[@]}" >/dev/null \
    || fail "Could not create the store (check the password rules and the email)"
  step "store $slug ready"
}

# configure-tunnel <hostname>; stdin: the Cloudflare tunnel credentials JSON
# (from `cloudflared tunnel create`). Writes the credentials, a config that
# only publishes the local web server, and the public URL.
cmd_configure_tunnel() {
  local hostname="${1:-}" tmp tunnel_id name ingress=""
  (( $# >= 1 && $# <= 10 )) || fail "Pass one to ten hostnames" 64
  for name in "$@"; do
    [[ "$name" =~ ^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}$ ]] || fail "Hostname is invalid: $name" 64
    ingress+="  - hostname: $name"$'\n'"    service: http://127.0.0.1:3000"$'\n'
  done
  [[ -d "$SECRETS_DIR" && ! -L "$SECRETS_DIR" ]] || fail "Run bootstrap first"
  tmp="$(mktemp "$SECRETS_DIR/.tunnel.XXXXXX")" || fail "Could not create a temporary file"
  head -c 16385 > "$tmp"
  if (( $(stat -f '%z' "$tmp") > 16384 )); then rm -f "$tmp"; fail "Tunnel credentials are too large" 64; fi
  tunnel_id="$(manifest_value "$tmp" TunnelID)"
  if [[ ! "$tunnel_id" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] \
    || [[ -z "$(manifest_value "$tmp" TunnelSecret)" ]]; then
    rm -f "$tmp"; fail "This is not a Cloudflare tunnel credentials file" 64
  fi
  chown "$SERVICE_USER:staff" "$tmp" && chmod 0600 "$tmp" && mv -f -- "$tmp" "$SECRETS_DIR/cloudflared-tunnel.json" \
    || { rm -f "$tmp"; fail "Could not write the tunnel credentials"; }
  tmp="$(mktemp "$SECRETS_DIR/.cloudflared.XXXXXX")" || fail "Could not create a temporary file"
  cat > "$tmp" <<EOF
# Managed by lumapos-admin configure-tunnel
tunnel: $tunnel_id
credentials-file: $SECRETS_DIR/cloudflared-tunnel.json
ingress:
${ingress}  - service: http_status:404
EOF
  chown "$SERVICE_USER:staff" "$tmp" && chmod 0600 "$tmp" && mv -f -- "$tmp" "$SECRETS_DIR/cloudflared.yml" \
    || { rm -f "$tmp"; fail "Could not write cloudflared.yml"; }
  set_env_value LUMAPOS_PUBLIC_URL "https://$hostname" || fail "Could not update runtime.env"
  [[ -f "$(plist_of cloudflared)" ]] || write_packaged_plist cloudflared
  is_loaded cloudflared && launchctl kickstart -k "$(target_of cloudflared)" >/dev/null 2>&1
  step "tunnel $tunnel_id for $hostname"
}

# Starts the packaged services in order: PostgreSQL, web (until it answers),
# workers, then the tunnel when it is configured.
cmd_start_services() {
  local name pg_major
  current_version >/dev/null || fail "No active runtime"
  [[ -f "$PGDATA/PG_VERSION" ]] || fail "Run init-database first"
  pg_major="$(manifest_value "$CURRENT_LINK/manifest.json" postgres.major)"
  for name in "${PACKAGED_SERVICES[@]}"; do
    [[ -f "$(plist_of "$name")" ]] || write_packaged_plist "$name" "$pg_major"
  done
  step "postgres"
  load_service postgres && wait_postgres || fail "PostgreSQL did not start"
  step "web"
  load_service web && wait_live || fail "The web server did not start; see logs/web.log"
  step "workers"
  load_services sync notifications backups || fail "A worker did not start"
  if [[ -f "$SECRETS_DIR/cloudflared.yml" ]]; then
    step "tunnel"
    load_service cloudflared || fail "cloudflared did not start"
  fi
  step "services running"
}

# ---- network ----

# set-network <local|lan>: local keeps the web server on 127.0.0.1 (the
# Cloudflare Tunnel still publishes it); lan also listens on the store
# network at http://<LocalHostName>.local:3000 and lets the session cookie
# work over plain http there.
cmd_set_network() {
  local mode="${1:-}" host
  [[ -d "$SECRETS_DIR" && ! -L "$SECRETS_DIR" ]] || fail "Run bootstrap first"
  case "$mode" in
    local)
      set_env_value LUMAPOS_LISTEN_ADDRESS 127.0.0.1 && set_env_value LUMAPOS_LAN_HTTP false \
        || fail "Could not update runtime.env"
      if [[ ! -f "$SECRETS_DIR/cloudflared.yml" && "$(env_value LUMAPOS_PUBLIC_URL)" == http://*.local:3000 ]]; then
        set_env_value LUMAPOS_PUBLIC_URL "http://127.0.0.1:3000" || fail "Could not update runtime.env"
      fi
      ;;
    lan)
      host="$(scutil --get LocalHostName 2>/dev/null)"
      [[ "$host" =~ ^[A-Za-z0-9-]{1,63}$ ]] || fail "This Mac has no usable local host name (System Settings > General > Sharing)"
      set_env_value LUMAPOS_LISTEN_ADDRESS 0.0.0.0 && set_env_value LUMAPOS_LAN_HTTP true \
        || fail "Could not update runtime.env"
      # The tunnel's https address stays the public one when there is a tunnel.
      if [[ ! -f "$SECRETS_DIR/cloudflared.yml" ]]; then
        set_env_value LUMAPOS_PUBLIC_URL "http://$host.local:3000" || fail "Could not update runtime.env"
      fi
      ;;
    *) fail "Network mode must be local or lan" 64 ;;
  esac
  if is_loaded web; then
    step "restart web"
    launchctl kickstart -k "$(target_of web)" >/dev/null 2>&1 && wait_live || fail "The web server did not come back"
  fi
  step "network $mode${host:+ $host.local}"
}

# ---- restore from Google Drive (setup on a new Mac) ----

# Runs a one-shot worker of the active runtime as the service user.
run_worker() {
  local app="$CURRENT_LINK/app"
  sudo -u "$SERVICE_USER" -- /usr/bin/env -i \
    PATH="$CURRENT_LINK/tools/bin:/usr/bin:/bin" \
    TMPDIR="$LUMAPOS_ROOT/backup-staging/" \
    LUMAPOS_APP_ROOT="$app" LUMAPOS_ENV_FILE="$RUNTIME_ENV" \
    LUMAPOS_BUN_BIN="$CURRENT_LINK/tools/bin/bun" \
    LUMAPOS_POSTGRES_BIN_DIR="$(postgres_bin)" \
    LUMAPOS_RCLONE_BIN="$CURRENT_LINK/tools/bin/rclone" \
    /bin/bash "$app/ops/shared/run-service.sh" "$@"
}

public_relation_count() {
  db_psql -d "$DATABASE_NAME" -At -c "SELECT count(*) FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE n.nspname = 'public' AND c.relkind IN ('r','p','S','v','m','f')"
}

# configure-drive <remote>; stdin: the rclone.conf that holds the Google
# Drive remote (from the old Mac). <remote> is name:folder, as in
# LUMAPOS_BACKUP_REMOTE.
cmd_configure_drive() {
  local remote="${1:-}"
  [[ "$remote" =~ ^[A-Za-z0-9_-]+:[^[:space:][:cntrl:]\\]+$ && ${#remote} -le 200 && "$remote" != *..* && "$remote" != *:/* ]] \
    || fail "Drive folder must look like lumapos:Backups/LumaPOS" 64
  current_version >/dev/null || fail "No active runtime"
  cmd_write_secret rclone.conf >/dev/null || exit $?
  set_env_value LUMAPOS_RCLONE_CONFIG "$SECRETS_DIR/rclone.conf" \
    && set_env_value LUMAPOS_BACKUP_REMOTE "$remote" \
    && set_env_value LUMAPOS_BACKUP_PROVIDER google-drive \
    || fail "Could not update runtime.env"
  # Creates the folder when it is new (a new store) and proves the
  # connection works; rclone may refresh the token in rclone.conf.
  step "check drive"
  sudo -u "$SERVICE_USER" -- /usr/bin/env -i PATH=/usr/bin:/bin HOME="$LUMAPOS_ROOT/backup-staging" \
    "$CURRENT_LINK/tools/bin/rclone" --config "$SECRETS_DIR/rclone.conf" --ask-password=false \
    --bind 0.0.0.0 --contimeout 30s --timeout 60s --retries 2 mkdir "$remote" >/dev/null 2>&1 \
    || fail "Could not reach the Google Drive folder $remote (check the sign-in or rclone.conf)"
  step "drive $remote"
}

# set-backup-key; stdin: the 64-hex backup key of the old Mac. Only while
# the database is still empty: replacing the key of a store that already
# has data would make its own archives unreadable.
cmd_set_backup_key() {
  local key count
  IFS= read -r key || true
  key="$(printf '%s' "$key" | tr -d '[:space:]' | tr 'A-F' 'a-f')"
  [[ "$key" =~ ^[0-9a-f]{64}$ ]] || fail "The backup key must be 64 hexadecimal characters" 64
  current_version >/dev/null || fail "No active runtime"
  wait_postgres || fail "PostgreSQL is not running"
  count="$(public_relation_count)" || fail "Could not inspect the database"
  [[ "$count" == 0 ]] || fail "The database already has data; its backup key stays as it is" 65
  set_env_value LUMAPOS_BACKUP_ENCRYPTION_KEY "$key" || fail "Could not update runtime.env"
  step "backup key set"
}

# list-backups: one JSON line {"archives":[{archiveKey,sizeBytes,modifiedAt}]}.
cmd_list_backups() {
  current_version >/dev/null || fail "No active runtime"
  [[ -f "$CURRENT_LINK/app/workers/list-drive-backups.js" ]] || fail "This runtime cannot list backups"
  run_worker list-backups || fail "Could not read the backups on Google Drive (check rclone.conf and the folder)"
}

# Archives carry the old Mac's runtime settings (keys that encrypt or sign
# stored data, feature flags; not the database URLs or machine paths). The
# restore worker leaves them in backup-staging; they replace this Mac's
# generated values.
readonly MACHINE_SPECIFIC_KEYS=" DATABASE_URL MIGRATION_DATABASE_URL LUMAPOS_RCLONE_BIN LUMAPOS_POSTGRES_BIN_DIR LUMAPOS_BUN_BIN LUMAPOS_LISTEN_ADDRESS LUMAPOS_LAN_HTTP "
merge_restored_settings() {
  local file="$LUMAPOS_ROOT/backup-staging/restored-settings.env" line key count=0
  [[ -f "$file" && ! -L "$file" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || continue
    key="${BASH_REMATCH[1]}"
    [[ "$MACHINE_SPECIFIC_KEYS" == *" $key "* ]] && continue
    set_env_value "$key" "${BASH_REMATCH[2]}" || { rm -f -- "$file"; return 1; }
    count=$((count + 1))
  done < "$file"
  rm -f -- "$file"
  step "settings $count keys from the archive"
}

# Restores <archive> (a Drive key or an archive name in backup-staging) into
# this empty install, then applies the migrations of the active runtime.
restore_archive() {
  local archive="$1" app="$CURRENT_LINK/app" count name
  current_version >/dev/null || fail "No active runtime"
  wait_postgres || fail "PostgreSQL is not running"
  for name in web sync notifications backups; do
    is_loaded "$name" && fail "Stop LumaPOS before restoring (service $name is running)" 65
  done
  count="$(public_relation_count)" || fail "Could not inspect the database"
  [[ "$count" == 0 ]] || fail "The database already has data; restore needs an empty install" 65
  [[ -f "$app/sql/bootstrap-local-postgres-compat.sql" ]] || fail "Runtime has no sql/ scripts"
  step "compat"
  { printf 'SET ROLE %s;\n' "$OWNER_ROLE"; cat "$app/sql/bootstrap-local-postgres-compat.sql"; } \
    | db_psql -d "$DATABASE_NAME" >/dev/null || fail "Could not prepare the database"
  step "restore (large backups take a while)"
  run_worker restore-backup --confirm-empty-database --archive "$archive" >/dev/null \
    || return 1
  merge_restored_settings || fail "The backup was restored but its settings could not be applied"
  step "migrate"
  run_migrations >/dev/null || fail "The backup was restored but migrations failed"
  step "restored"
}

# restore-backup <google-drive/YYYY/MM/DD/lumapos-<uuid>.lumaenc>
cmd_restore_backup() {
  local archive="${1:-}"
  [[ "$archive" =~ ^google-drive/[0-9]{4}/[0-9]{2}/[0-9]{2}/lumapos-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\.lumaenc$ ]] \
    || fail "Unknown backup archive" 64
  restore_archive "$archive" || fail "Restore failed (check the backup key)"
}

# restore-file <path to a .lumaenc>: an archive from export-for-move (or a
# downloaded backup) that the owner picked. Root only copies it into
# backup-staging under a generated name; the worker reads that copy.
cmd_restore_file() {
  local source="${1:-}" name staged
  [[ "$source" == /* && "$source" == *.lumaenc && "$source" != *..* ]] || fail "Choose a .lumaenc archive" 64
  [[ "$source" == /Users/* || "$source" == /Volumes/* ]] || fail "The archive must be in a user folder or on a mounted disk" 64
  [[ -f "$source" && ! -L "$source" ]] || fail "The archive is missing or is a link" 66
  name="lumapos-$(uuidgen | tr 'A-F' 'a-f')-$(($(date +%s) * 1000)).lumaenc"
  staged="$LUMAPOS_ROOT/backup-staging/$name"
  step "copy archive"
  cp -X -- "$source" "$staged" && chown "$SERVICE_USER:staff" "$staged" && chmod 0600 "$staged" \
    || { rm -f -- "$staged"; fail "Could not copy the archive"; }
  restore_archive "$name"
  local status=$?
  rm -f -- "$staged"
  (( status == 0 )) || fail "Restore failed (check the backup key)"
}

# ---- moving to another Mac ----

readonly MOVE_MARKER="$LUMAPOS_ROOT/.moved-out"
readonly EXPORT_DIR="$LUMAPOS_ROOT/exports"

# export-for-move: stops everything that writes (and the tunnel, so devices
# queue their sales), keeps those services off across reboots, and writes an
# encrypted archive to /Users/Shared/LumaPOS/exports for the user who asked.
# cancel-move starts the store again on this Mac.
cmd_export_for_move() {
  local owner="${SUDO_USER:-}" output archive name
  current_version >/dev/null || fail "Moving needs the packaged install"
  [[ -n "$owner" && "$owner" != root ]] && id -u "$owner" >/dev/null 2>&1 || fail "Run through sudo as the Mac user" 64
  [[ -f "$CURRENT_LINK/app/workers/export-store.js" ]] || fail "This runtime cannot export the store"
  wait_postgres || fail "PostgreSQL is not running"
  step "stop services"
  unload_services cloudflared web sync notifications backups
  for name in cloudflared web sync notifications backups; do
    launchctl disable "$(target_of "$name")" 2>/dev/null || true
  done
  date -u +%Y-%m-%dT%H:%M:%SZ > "$MOVE_MARKER"
  step "export (large stores take a while)"
  if ! output="$(run_worker export-store)"; then
    rm -f "$MOVE_MARKER"
    cmd_start_services >/dev/null 2>&1
    fail "Export failed; LumaPOS was started again on this Mac"
  fi
  archive="$(printf '%s\n' "$output" | sed -n 's/.*"archiveName":"\(lumapos-[0-9a-f-]*\.lumaenc\)".*/\1/p' | tail -n 1)"
  [[ -n "$archive" && -f "$LUMAPOS_ROOT/backup-staging/$archive" ]] || fail "The export did not produce an archive"
  ensure_dir "$EXPORT_DIR" root:wheel 0755
  name="LumaPOS-move-$(date +%Y%m%d-%H%M).lumaenc"
  mv -f -- "$LUMAPOS_ROOT/backup-staging/$archive" "$EXPORT_DIR/$name" \
    && chown "$owner:staff" "$EXPORT_DIR/$name" && chmod 0600 "$EXPORT_DIR/$name" \
    || fail "Could not hand the archive over"
  step "exported $EXPORT_DIR/$name"
}

cmd_cancel_move() {
  current_version >/dev/null || fail "Moving needs the packaged install"
  rm -f "$MOVE_MARKER"
  cmd_start_services
}

# ---- uninstall ----

# uninstall: stops and removes the LumaPOS services, this helper and its
# sudoers rule. Data stays in /Users/Shared/LumaPOS (runtime, database,
# media, secrets) so setup can start again or another install can restore.
# uninstall delete-data <today as YYYYMMDD>: also deletes that folder; the
# date has to be typed as a confirmation.
# True when the newest archive on Drive is less than 24 hours old.
newest_drive_backup_is_recent() {
  local listing
  listing="$(run_worker list-backups 2>/dev/null | tail -n 1)" || return 1
  LISTING="$listing" /usr/bin/osascript -l JavaScript -e '
    const env = $.NSProcessInfo.processInfo.environment;
    const listing = JSON.parse(ObjC.unwrap(env.objectForKey("LISTING")));
    const newest = listing.archives.length ? Date.parse(listing.archives[0].modifiedAt) : 0;
    (Date.now() - newest < 24 * 3600 * 1000) ? "recent" : "old";' 2>/dev/null | grep -qx recent
}

cmd_uninstall() {
  local mode="${1:-keep-data}" confirmation="${2:-}" name
  current_version >/dev/null || fail "Only a packaged install can be removed here (this Mac runs the classic layout)" 65
  case "$mode" in
    keep-data) ;;
    delete-data)
      [[ "$confirmation" == "$(date +%Y%m%d)" ]] || fail "Type today's date (YYYYMMDD) to delete the data" 64
      newest_drive_backup_is_recent || fail "Deleting the data needs a Google Drive backup from the last 24 hours" 65
      ;;
    *) fail "Usage: uninstall [keep-data | delete-data YYYYMMDD]" 64 ;;
  esac
  step "stop services"
  for name in "${PACKAGED_SERVICES[@]}"; do
    launchctl bootout "$(target_of "$name")" 2>/dev/null || true
    rm -f -- "$(plist_of "$name")"
  done
  if [[ "$mode" == delete-data ]]; then
    step "delete data"
    rm -rf -- "$LUMAPOS_ROOT"
  fi
  step "remove helper"
  rm -f -- /etc/sudoers.d/lumapos
  step "uninstalled"
  rm -f -- /usr/local/libexec/lumapos-admin
}

# ---- secrets ----

cmd_write_secret() {
  local name="${1:-}" tmp size
  case "$name" in
    runtime.env|rclone.conf|cloudflared.yml|cloudflared-tunnel.json) ;;
    *) fail "Unknown secret: $name" 64 ;;
  esac
  [[ -d "$SECRETS_DIR" && ! -L "$SECRETS_DIR" ]] || fail "Run bootstrap first"
  tmp="$(mktemp "$SECRETS_DIR/.incoming.XXXXXX")" || fail "Could not create a temporary file"
  head -c 65537 > "$tmp"
  size="$(stat -f '%z' "$tmp")"
  if (( size == 0 || size > 65536 )); then rm -f "$tmp"; fail "Secret must be 1 byte to 64 KiB" 64; fi
  chown "$SERVICE_USER:staff" "$tmp" && chmod 0600 "$tmp" && mv -f -- "$tmp" "$SECRETS_DIR/$name" \
    || { rm -f "$tmp"; fail "Could not write $name"; }
  step "wrote $name"
}

cmd_status() {
  local version name
  version="$(current_version 2>/dev/null || true)"
  printf 'helper=%s\n' "$HELPER_VERSION"
  printf 'layout=%s\n' "$([[ -n "$version" ]] && echo packaged || { [[ -d "$LIVE_ROOT" ]] && echo classic || echo none; })"
  printf 'runtime=%s\n' "$version"
  printf 'previous=%s\n' "$(cat "$RUNTIME_DIR/.previous" 2>/dev/null || true)"
  printf 'network=%s\n' "$([[ "$(env_value LUMAPOS_LISTEN_ADDRESS 2>/dev/null)" == 0.0.0.0 ]] && echo lan || echo local)"
  printf 'drive=%s\n' "$(env_value LUMAPOS_BACKUP_REMOTE 2>/dev/null || true)"
  printf 'moved=%s\n' "$(cat "$LUMAPOS_ROOT/.moved-out" 2>/dev/null || true)"
  printf 'database=%s\n' "$([[ -f "$PGDATA/PG_VERSION" ]] && echo initialized || echo none)"
  for name in "${PACKAGED_SERVICES[@]}"; do
    printf 'service.%s=%s\n' "$name" "$(is_loaded "$name" && echo loaded || { [[ -f "$(plist_of "$name")" ]] && echo installed || echo missing; })"
  done
}

cmd_service() {
  local action="${1:-}" name
  name="$(service_name "${2:-}")" || exit $?
  case "$action" in
    start) load_service "$name" ;;
    stop) launchctl bootout "$(target_of "$name")" ;;
    restart) launchctl kickstart -k "$(target_of "$name")" ;;
    *) fail "Unknown service action: $action" 64 ;;
  esac
}

cmd_log() {
  local name lines="${2:-300}" path
  name="$(service_name "${1:-}")" || exit $?
  [[ "$lines" =~ ^[0-9]{1,5}$ ]] || fail "Line count must be a number" 64
  # The path comes from the root-owned launchd definition, not from the caller.
  path="$(/usr/libexec/PlistBuddy -c 'Print :StandardErrorPath' "$(plist_of "$name")" 2>/dev/null \
    || /usr/libexec/PlistBuddy -c 'Print :StandardOutPath' "$(plist_of "$name")" 2>/dev/null)" || true
  [[ "$path" == /* && -f "$path" ]] || fail "No log file for $name" 66
  tail -n "$lines" -- "$path"
}

case "${1:-}" in
  deploy) shift; [[ $# == 0 ]] || fail "deploy takes no arguments" 64; cmd_deploy ;;
  service) shift; cmd_service "$@" ;;
  log) shift; cmd_log "$@" ;;
  version) echo "$HELPER_VERSION" ;;
  status) cmd_status ;;
  bootstrap) shift; cmd_bootstrap "$@" ;;
  create-accounts) cmd_create_accounts ;;
  install-runtime) shift; cmd_install_runtime "$@" ;;
  activate-runtime) shift; cmd_activate_runtime "${1:-}" ;;
  rollback-runtime) cmd_rollback_runtime ;;
  init-database) cmd_init_database ;;
  migrate) cmd_migrate ;;
  write-secret) shift; cmd_write_secret "$@" ;;
  init-runtime-env) shift; cmd_init_runtime_env "${1:-}" ;;
  backup-key) cmd_backup_key ;;
  provision-store) shift; cmd_provision_store "$@" ;;
  configure-tunnel) shift; cmd_configure_tunnel "$@" ;;
  start-services) cmd_start_services ;;
  configure-drive) shift; cmd_configure_drive "${1:-}" ;;
  set-network) shift; cmd_set_network "${1:-}" ;;
  restore-file) shift; cmd_restore_file "${1:-}" ;;
  export-for-move) cmd_export_for_move ;;
  cancel-move) cmd_cancel_move ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  set-backup-key) cmd_set_backup_key ;;
  list-backups) cmd_list_backups ;;
  restore-backup) shift; cmd_restore_backup "${1:-}" ;;
  *) fail "Usage: lumapos-admin deploy | service start|stop|restart <name> | log <name> [lines] | version | status | bootstrap <user> | create-accounts | install-runtime <archive> [sha256] | activate-runtime <version> | rollback-runtime | init-database | migrate | write-secret <name> | init-runtime-env [public-url] | backup-key | provision-store <slug> <email> | configure-tunnel <hostname>... | start-services | configure-drive <remote> | set-backup-key | list-backups | restore-backup <archive> | set-network <local|lan> | restore-file <path> | export-for-move | cancel-move | uninstall [keep-data|delete-data YYYYMMDD]" 64 ;;
esac
