<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.lumapos.sync</string>
	<key>UserName</key>
	<string>_lumapos_svc</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/Shared/LumaPOS/app/ops/shared/run-service.sh</string>
		<string>sync</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/Shared/LumaPOS/app</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>LUMAPOS_APP_ROOT</key>
		<string>/Users/Shared/LumaPOS/app</string>
		<key>LUMAPOS_ENV_FILE</key>
		<string>/Users/Shared/LumaPOS/secrets/runtime.env</string>
		<key>LUMAPOS_BUN_BIN</key>
		<string>/opt/homebrew/bin/bun</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>StandardOutPath</key>
	<string>/Users/Shared/LumaPOS/logs/sync.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/Shared/LumaPOS/logs/sync.log</string>
</dict>
</plist>
